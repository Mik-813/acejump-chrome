{
  "manifest_version": 3,
  "name": "AceJump - jump to any visible text with the keyboard",
  "short_name": "AceJump",
  "version": "1.0.0",
  "description": "Jump to any visible text with the keyboard (AceJump / Vimium style) and select it in caret mode.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "AceJump: jump to text",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "activate": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Start a jump (open the search input)"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
